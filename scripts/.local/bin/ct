#!/bin/bash
dir=$(zoxide query -i "$1")
if [ -z "$dir" ]; then
    echo "No directory found for: $1"
    exit 1
fi

name=$(basename "$dir" | sed 's/^\./_/')

workspace_id=$(herdr workspace list 2>/dev/null | \
    jq -r ".result.workspaces[] | select(.label == \"$name\") | .workspace_id" 2>/dev/null)

if [ -n "$workspace_id" ]; then
    herdr workspace focus "$workspace_id" >/dev/null 2>&1
else
    result=$(herdr workspace create --cwd "$dir" --label "$name" --focus 2>&1)
    pane_id=$(echo "$result" | jq -r '.result.root_pane.pane_id' 2>/dev/null)
    if [ -f "$dir/init.sh" ] && [ "$pane_id" != "null" ]; then
        chmod +x "$dir/init.sh" 2>/dev/null
        herdr pane run "$pane_id" "./init.sh" >/dev/null 2>&1
    fi
fi

if [ -z "$HERDR_ENV" ]; then
    exec herdr
fi
